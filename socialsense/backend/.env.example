PORT=3001
FRONTEND_URL=http://localhost:5173

# Optional: "demo" needs only OpenAI; "full" enables auth, billing, and schedules.
# If omitted, startup selects full only when Supabase and Stripe are configured.
# APP_MODE=demo

# Required for the public LLM demo and AI analysis features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
# AI_ENABLED=false

# Optional public-demo limit per IP per 15 minutes (default: 20).
# DEMO_RATE_LIMIT_MAX=20

# Optional: use an OpenAI-compatible endpoint.
# OPENAI_BASE_URL=http://localhost:11434/v1

# Required only for the original authenticated SaaS workflow.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
YOUTUBE_API_KEY=
